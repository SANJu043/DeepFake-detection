# ========================
# Application Settings
# ========================
APP_NAME=deepfake-auth
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_HOST=0.0.0.0
API_PORT=8000

# ========================
# Database (PostgreSQL)
# ========================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=deepfake_auth
POSTGRES_USER=dfauth
POSTGRES_PASSWORD=change-me-postgres-password

# ========================
# Redis / Celery
# ========================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ========================
# MinIO / S3 Storage
# ========================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=deepfake-auth-videos
MINIO_USE_SSL=false

# ========================
# JWT Authentication
# ========================
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ========================
# Cryptographic Signing
# ========================
# Options: "softhsm", "vault", "local"
SIGNER_BACKEND=local
# For local signer (demo only)
SIGNING_KEY_DIR=/app/keys
# For Vault
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=change-me-vault-token
VAULT_TRANSIT_KEY=deepfake-auth-signer

# SoftHSM
SOFTHSM2_CONF=/etc/softhsm2.conf
SOFTHSM_PIN=change-me-hsm-pin
SOFTHSM_SLOT=0

# ========================
# TSA (Timestamping)
# ========================
# Options: "local", "freetsa", "custom"
TSA_BACKEND=local
TSA_URL=http://freetsa.org/tsr
# For local TSA (demo)
TSA_KEY_DIR=/app/keys/tsa

# ========================
# Detection Models
# ========================
MODEL_WEIGHTS_DIR=/app/weights
MAX_FRAMES=300
FRAME_SAMPLE_INTERVAL=0.2
FACE_DETECTOR=retinaface
FACE_CROP_MARGIN=0.2
FACE_CROP_SIZE=380

# ========================
# Policy Engine Thresholds
# ========================
THRESHOLD_CLEAN=0.30
THRESHOLD_MANIPULATED=0.70

# ========================
# Upload Limits
# ========================
MAX_UPLOAD_SIZE_MB=200
ALLOWED_EXTENSIONS=mp4,mov,webm
ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm

# ========================
# Anomaly Detection
# ========================
ANOMALY_WINDOW_MINUTES=10
ANOMALY_THRESHOLD=0.5
FAILED_LOGIN_LIMIT=5
UPLOAD_RATE_LIMIT=20

# ========================
# Encryption at Rest
# ========================
MASTER_KEY=change-me-256-bit-hex-key

# ========================
# CORS
# ========================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000