FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    softhsm2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements-backend.txt
COPY ml/requirements.txt /app/requirements-ml.txt
RUN pip install --no-cache-dir -r requirements-backend.txt -r requirements-ml.txt

COPY backend/ /app/backend/
COPY ml/ /app/ml/

ENV PYTHONPATH=/app

CMD ["celery", "-A", "backend.app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
